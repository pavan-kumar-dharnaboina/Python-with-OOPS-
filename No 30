class ShoppingCart:
    def __init__(self):
        self.items = []

    def add_item(self, name, price):
        self.items.append((name, price))

    def total(self):
        amount = sum(price for name, price in self.items)
        print("Total Amount:", amount)

cart = ShoppingCart()
cart.add_item("Laptop", 50000)
cart.add_item("Mouse", 500)
cart.total()
