class Student:
    def __init__(self, name, marks):
        self.name = name
        self.marks = marks

    def grade(self):
        avg = sum(self.marks) / len(self.marks)

        if avg >= 90:
            print("Grade A")
        elif avg >= 75:
            print("Grade B")
        elif avg >= 50:
            print("Grade C")
        else:
            print("Fail")

s = Student("Pavan", [90, 85, 80])
s.grade()
